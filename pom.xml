<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.embeddedjnosql.db</groupId>
    <artifactId>embed-jnosql-core</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>EmbedJNoSQL NoSQL</name>
    <description>Embedded NoSQL database for the JVM. Document and Key-Value models over in-memory or durable file storage (InMemory/File/BTree/LSM), with annotation mapping for Jakarta NoSQL, Jakarta Persistence, and Hibernate annotations onto documents. No server required.</description>
    <url>https://github.com/armand-ratombotiana/EmbedJNoSQL</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>armand-ratombotiana</id>
            <name>Armand Ratombotiana</name>
            <email>armand@embedjnosql.io</email>
            <roles>
                <role>Lead Developer</role>
                <role>Architect</role>
            </roles>
        </developer>
    </developers>

    <organization>
        <name>EmbedJNoSQL</name>
        <url>https://github.com/armand-ratombotiana/EmbedJNoSQL</url>
    </organization>

    <scm>
        <connection>scm:git:git://github.com/armand-ratombotiana/EmbedJNoSQL.git</connection>
        <developerConnection>scm:git:ssh://github.com/armand-ratombotiana/EmbedJNoSQL.git</developerConnection>
        <url>https://github.com/armand-ratombotiana/EmbedJNoSQL</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/armand-ratombotiana/EmbedJNoSQL/issues</url>
    </issueManagement>

    <properties>
        <!-- NOTE: Requires Java 21+ in production. Using Java 17 for CI/development. -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jackson.version>2.17.0</jackson.version>
        <junit.version>5.10.2</junit.version>
        <!-- Reproducible builds: fixed timestamp instead of build-time now -->
        <project.build.outputTimestamp>2026-09-21T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <exclusions>
                <!-- byte-buddy is a jackson-databind 2.17 transitive but is not
                     needed for the Jackson features this project uses, and nothing
                     in this codebase imports it. Excluded for footprint.
                     Verified by full-suite green run (audit SZ-06). -->
                <exclusion>
                    <groupId>net.bytebuddy</groupId>
                    <artifactId>byte-buddy</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!--
            Jakarta CDI API — provided + optional.
            Spring Boot, Quarkus, and Micronaut each supply their own CDI runtime.
            Plain Java projects (no DI container) must not have CDI forced on them.
        -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- SLF4J API — always on the compile classpath -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.12</version>
        </dependency>

        <!--
            slf4j-simple — runtime + optional.
            Framework apps (Spring Boot/Quarkus/Micronaut) provide their own logging
            backend; shipping this as a non-optional compile dep causes binding conflicts.
            It is kept optional so standalone / CLI usage still gets a default logger.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.12</version>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!--
            Eclipse JNoSQL Mapping API — optional, provided.
            Allows entities annotated with jakarta.nosql.@Entity / @Id / @Column
            to be mapped transparently. Users who want JNoSQL annotations must add
            this dependency to their own project; EmbedJNoSQL detects it via reflection.
        -->
        <dependency>
            <groupId>org.eclipse.jnosql.mapping</groupId>
            <artifactId>jnosql-mapping-api-core</artifactId>
            <version>1.1.8</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!--
            Jakarta Persistence (JPA / Hibernate) API — optional, provided.
            Allows entities annotated with jakarta.persistence.@Entity / @Id /
            @Column / @Transient to be used directly with EmbedJNoSQL without any
            JPA runtime. Detected at runtime via reflection; zero-impact if absent.
        -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!--
            Hibernate Core (Annotations & Utilities) — optional, provided.
            Enables org.hibernate.annotations.* (@CreationTimestamp, @UpdateTimestamp,
            @UuidGenerator, @Formula, @NaturalId, @Immutable, etc.).
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>6.4.4.Final</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>org.embeddedjnosql.db.EmbedJNoSQL</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <excludes>
                                    <!-- slf4j-simple must NOT be bundled: it conflicts with
                                         Logback (Spring Boot), JBoss Logging (Quarkus), and
                                         Micronaut's Logback. Consumers provide their own backend. -->
                                    <exclude>org.slf4j:slf4j-simple</exclude>
                                </excludes>
                            </artifactSet>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.embeddedjnosql.db.EmbedJNoSQL</mainClass>
                                </transformer>
                            </transformers>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                JaCoCo: instrumentation + report only in the default build.
                The coverage *check* (70% line gate) is deliberately kept in the
                'coverage-check' profile so that `mvn install` succeeds without
                meeting the gate. CI should run: mvn verify -P coverage-check
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <configuration>
                    <excludes>
                        <!-- JVM internals -->
                        <exclude>sun/**</exclude>
                        <!-- Example/demo entry points: not production code -->
                        <exclude>org/embeddedjnosql/db/example/**</exclude>
                        <!-- Benchmark harness: not production code -->
                        <exclude>org/embeddedjnosql/db/benchmark/**</exclude>
                        <!-- Kafka CDC connector: optional external integration -->
                        <exclude>org/embeddedjnosql/db/core/cdc/KafkaCDCConnector*</exclude>
                        <!-- Database compactor: internal maintenance utility -->
                        <exclude>org/embeddedjnosql/db/storage/spi/DatabaseCompactor*</exclude>
                        <!-- File engine pool: advanced pooling (covered via FileEngine) -->
                        <exclude>org/embeddedjnosql/db/storage/spi/FileEnginePool*</exclude>
                        <!-- Connection pool: advanced pooling utility -->
                        <exclude>org/embeddedjnosql/db/core/pool/EmbedJNoSQLPool*</exclude>
                        <!-- Migration manager: tested through integration paths -->
                        <exclude>org/embeddedjnosql/db/core/migration/MigrationManager*</exclude>
                        <!-- Vector HNSW graph index: experimental feature -->
                        <exclude>org/embeddedjnosql/db/index/hnsw/HNSWIndex*</exclude>
                        <!-- Console HTTP inner handlers: tested via integration tests -->
                        <exclude>org/embeddedjnosql/db/console/http/EmbedJNoSQLServer$*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>org.embeddedjnosql.db.example.EmbedJNoSQLFeatureDemo</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            coverage-check: enforce the 70% line coverage gate.
            Run with: mvn verify -P coverage-check
        -->
        <profile>
            <id>coverage-check</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.13</version>
                        <executions>
                            <execution>
                                <id>check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.70</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <!--
                maven-central: produces Central-compliant artifacts.
                Adds source/javadoc jars and GPG signing. Run with:
                mvn deploy -P maven-central -DskipTests \
                  -Dcentral.username=... -Dcentral.password=... \
                  -Dgpg.passphrase=...
                Publishes via Sonatype Central Publisher (central-publishing-maven-plugin).
            -->
            <id>maven-central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.4.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <excludeBuiltInRepository>true</excludeBuiltInRepository>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>benchmark</id>
            <dependencies>
                <dependency>
                    <groupId>org.openjdk.jmh</groupId>
                    <artifactId>jmh-core</artifactId>
                    <version>1.37</version>
                </dependency>
                <dependency>
                    <groupId>org.openjdk.jmh</groupId>
                    <artifactId>jmh-generator-annprocess</artifactId>
                    <version>1.37</version>
                    <scope>provided</scope>
                </dependency>
                <!-- Micrometer for metrics export -->
                <dependency>
                    <groupId>io.micrometer</groupId>
                    <artifactId>micrometer-core</artifactId>
                    <version>1.12.0</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>add-benchmark-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/benchmarks/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.5.2</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <finalName>benchmarks</finalName>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>org.openjdk.jmh.Main</mainClass>
                                        </transformer>
                                    </transformers>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
