{"method":"GET","url":"http://localhost:9090/jnosql-admin/login.html","requestBody":null,"statusCode":200,"responseHeaders":{"Status-Line":["HTTP/1.1 200 OK"],"Content-type":["text/html"],"Access-control-allow-origin":["*"],"Access-control-allow-headers":["Content-Type, X-API-Key, Authorization, Cookie, X-CSRF-Token"],"X-frame-options":["DENY"],"Referrer-policy":["strict-origin-when-cross-origin"],"Content-length":["7600"],"X-content-type-options":["nosniff"],"Date":["Fri, 09 Oct 2026 18:23:16 GMT"],"Content-security-policy":["default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"],"Access-control-allow-methods":["GET, POST, PUT, DELETE, OPTIONS"],"X-xss-protection":["1; mode=block"]},"responseBody":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>EmbedJNoSQL — Sign In</title>\r\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">\r\n    <link rel=\"stylesheet\" href=\"/css/console.css\">\r\n    <style>\r\n        :root {\r\n            --bg-base: #090914;\r\n            --bg-card: rgba(18, 20, 38, 0.85);\r\n            --border-card: rgba(255, 255, 255, 0.08);\r\n            --accent-grad: linear-gradient(135deg, #fbbf24, #f59e0b);\r\n            --accent-glow: rgba(251, 191, 36, 0.25);\r\n            --text-main: #f8fafc;\r\n            --text-sub: #94a3b8;\r\n        }\r\n        body {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            min-height: 100vh;\r\n            background: radial-gradient(circle at 50% 20%, rgba(245, 158, 11, 0.10) 0%, transparent 60%), #090914;\r\n            font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\r\n            color: var(--text-main);\r\n            margin: 0;\r\n            padding: 24px;\r\n            box-sizing: border-box;\r\n        }\r\n        .login-card {\r\n            background: var(--bg-card);\r\n            backdrop-filter: blur(16px);\r\n            -webkit-backdrop-filter: blur(16px);\r\n            border: 1px solid var(--border-card);\r\n            border-radius: 16px;\r\n            width: 100%;\r\n            max-width: 420px;\r\n            padding: 36px 32px;\r\n            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.05);\r\n            transition: transform 0.2s ease, box-shadow 0.2s ease;\r\n        }\r\n        .login-header {\r\n            text-align: center;\r\n            margin-bottom: 28px;\r\n        }\r\n        .login-logo-wrap {\r\n            display: inline-flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            margin-bottom: 18px;\r\n            filter: drop-shadow(0 8px 24px var(--accent-glow));\r\n        }\r\n        .login-title {\r\n            font-size: 1.6rem;\r\n            font-weight: 700;\r\n            letter-spacing: -0.02em;\r\n            color: #ffffff;\r\n            margin: 0 0 6px 0;\r\n        }\r\n        .login-subtitle {\r\n            font-size: 0.85rem;\r\n            color: var(--text-sub);\r\n            margin: 0;\r\n        }\r\n        .login-badge {\r\n            display: inline-block;\r\n            margin-top: 8px;\r\n            padding: 3px 10px;\r\n            border-radius: 50px;\r\n            font-size: 0.72rem;\r\n            font-weight: 600;\r\n            background: rgba(245, 158, 11, 0.12);\r\n            color: #fcd34d;\r\n            border: 1px solid rgba(245, 158, 11, 0.35);\r\n        }\r\n        .form-group {\r\n            margin-bottom: 18px;\r\n        }\r\n        .form-label {\r\n            display: block;\r\n            font-size: 0.82rem;\r\n            font-weight: 600;\r\n            color: #cbd5e1;\r\n            margin-bottom: 6px;\r\n        }\r\n        .form-input {\r\n            width: 100%;\r\n            padding: 11px 14px;\r\n            background-color: rgba(10, 12, 24, 0.75);\r\n            border: 1px solid rgba(255, 255, 255, 0.12);\r\n            border-radius: 8px;\r\n            color: #ffffff;\r\n            font-size: 0.88rem;\r\n            box-sizing: border-box;\r\n            transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;\r\n        }\r\n        .form-input:focus {\r\n            outline: none;\r\n            background-color: rgba(15, 18, 35, 0.95);\r\n            border-color: #f59e0b;\r\n            box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.25);\r\n        }\r\n        .form-input::placeholder {\r\n            color: #64748b;\r\n        }\r\n        .btn-submit {\r\n            width: 100%;\r\n            padding: 12px 18px;\r\n            background: var(--accent-grad);\r\n            color: #ffffff;\r\n            border: none;\r\n            border-radius: 8px;\r\n            font-size: 0.9rem;\r\n            font-weight: 600;\r\n            cursor: pointer;\r\n            transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;\r\n            margin-top: 10px;\r\n            box-shadow: 0 4px 16px var(--accent-glow);\r\n        }\r\n        .btn-submit:hover:not(:disabled) {\r\n            opacity: 0.94;\r\n            transform: translateY(-1px);\r\n            box-shadow: 0 6px 20px rgba(245, 158, 11, 0.35);\r\n        }\r\n        .btn-submit:focus-visible {\r\n            outline: 2px solid #f59e0b;\r\n            outline-offset: 2px;\r\n        }\r\n        .btn-submit:disabled {\r\n            opacity: 0.6;\r\n            cursor: not-allowed;\r\n        }\r\n        .error-message {\r\n            display: none;\r\n            background-color: rgba(239, 68, 68, 0.15);\r\n            border: 1px solid rgba(239, 68, 68, 0.4);\r\n            color: #fca5a5;\r\n            padding: 11px 14px;\r\n            border-radius: 8px;\r\n            font-size: 0.84rem;\r\n            margin-bottom: 18px;\r\n            line-height: 1.4;\r\n        }\r\n        .login-footer {\r\n            margin-top: 28px;\r\n            text-align: center;\r\n            font-size: 0.75rem;\r\n            color: #64748b;\r\n            border-top: 1px solid rgba(255, 255, 255, 0.06);\r\n            padding-top: 16px;\r\n        }\r\n        /* Small screens: keep the card comfortable and touch-friendly */\r\n        @media (max-width: 480px) {\r\n            .login-card { padding: 28px 20px; }\r\n        }\r\n        /* Honor the OS reduced-motion preference (card transition, button lift) */\r\n        @media (prefers-reduced-motion: reduce) {\r\n            *, *::before, *::after {\r\n                transition-duration: 0.01ms !important;\r\n                animation-duration: 0.01ms !important;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"login-card\">\r\n        <div class=\"login-header\">\r\n            <div class=\"login-logo-wrap\">\r\n                <img src=\"/logo.svg\" alt=\"EmbedJNoSQL logo\" width=\"88\" height=\"88\" />\r\n            </div>\r\n            <h1 class=\"login-title\">EmbedJNoSQL Console</h1>\r\n            <p class=\"login-subtitle\">Sign in to manage your embedded database</p>\r\n            <span class=\"login-badge\">Multi-Model NoSQL &bull; Documents &bull; KV &bull; Wide-Column</span>\r\n        </div>\r\n\r\n        <div id=\"errorMessage\" class=\"error-message\" role=\"alert\"></div>\r\n\r\n        <form id=\"loginForm\" novalidate>\r\n            <div class=\"form-group\">\r\n                <label class=\"form-label\" for=\"username\">Username</label>\r\n                <input class=\"form-input\" type=\"text\" id=\"username\" name=\"username\" value=\"admin\" autocomplete=\"username\" aria-label=\"Username\" placeholder=\"e.g. admin\">\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n                <label class=\"form-label\" for=\"password\">Password</label>\r\n                <input class=\"form-input\" type=\"password\" id=\"password\" name=\"password\" autocomplete=\"current-password\" aria-label=\"Password\" placeholder=\"••••••••\">\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n                <label class=\"form-label\" for=\"apiKey\">API Key (Optional)</label>\r\n                <input class=\"form-input\" type=\"password\" id=\"apiKey\" name=\"apiKey\" aria-label=\"API key, optional\" placeholder=\"Leave blank if disabled\">\r\n            </div>\r\n\r\n            <button type=\"submit\" class=\"btn-submit\" id=\"submitBtn\">Sign In</button>\r\n        </form>\r\n\r\n        <div class=\"login-footer\">\r\n            EmbedJNoSQL Embedded NoSQL Database &bull; Secure Console\r\n        </div>\r\n    </div>\r\n\r\n    <script src=\"/js/login.js\" defer></script>\r\n\r\n</body>\r\n</html>\r\n"}