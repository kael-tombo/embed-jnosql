{"method":"GET","url":"http://localhost:9090/jnosql-admin/login.html","requestBody":null,"statusCode":200,"responseHeaders":{"Status-Line":["HTTP/1.1 200 OK"],"Content-type":["text/html"],"Access-control-allow-origin":["*"],"Access-control-allow-headers":["Content-Type, X-API-Key, Authorization, Cookie, X-CSRF-Token"],"X-frame-options":["DENY"],"Referrer-policy":["strict-origin-when-cross-origin"],"Content-length":["14110"],"X-content-type-options":["nosniff"],"Date":["Wed, 07 Oct 2026 06:28:51 GMT"],"Content-security-policy":["default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"],"Access-control-allow-methods":["GET, POST, PUT, DELETE, OPTIONS"],"X-xss-protection":["1; mode=block"]},"responseBody":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>JunifyDB — Sign In</title>\r\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">\r\n    <link rel=\"stylesheet\" href=\"/css/enhancements.css\">\r\n    <style>\r\n        :root {\r\n            --bg-base: #090914;\r\n            --bg-card: rgba(18, 20, 38, 0.85);\r\n            --border-card: rgba(255, 255, 255, 0.08);\r\n            --accent-grad: linear-gradient(135deg, #fbbf24, #f59e0b);\r\n            --accent-glow: rgba(251, 191, 36, 0.25);\r\n            --text-main: #f8fafc;\r\n            --text-sub: #94a3b8;\r\n        }\r\n        body {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            min-height: 100vh;\r\n            background: radial-gradient(circle at 50% 20%, rgba(245, 158, 11, 0.10) 0%, transparent 60%), #090914;\r\n            font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\r\n            color: var(--text-main);\r\n            margin: 0;\r\n            padding: 24px;\r\n            box-sizing: border-box;\r\n        }\r\n        .login-card {\r\n            background: var(--bg-card);\r\n            backdrop-filter: blur(16px);\r\n            -webkit-backdrop-filter: blur(16px);\r\n            border: 1px solid var(--border-card);\r\n            border-radius: 16px;\r\n            width: 100%;\r\n            max-width: 420px;\r\n            padding: 36px 32px;\r\n            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.05);\r\n            transition: transform 0.2s ease, box-shadow 0.2s ease;\r\n        }\r\n        .login-header {\r\n            text-align: center;\r\n            margin-bottom: 28px;\r\n        }\r\n        .login-logo-wrap {\r\n            display: inline-flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            margin-bottom: 18px;\r\n            filter: drop-shadow(0 8px 24px var(--accent-glow));\r\n        }\r\n        .login-title {\r\n            font-size: 1.6rem;\r\n            font-weight: 700;\r\n            letter-spacing: -0.02em;\r\n            color: #ffffff;\r\n            margin: 0 0 6px 0;\r\n        }\r\n        .login-subtitle {\r\n            font-size: 0.85rem;\r\n            color: var(--text-sub);\r\n            margin: 0;\r\n        }\r\n        .login-badge {\r\n            display: inline-block;\r\n            margin-top: 8px;\r\n            padding: 3px 10px;\r\n            border-radius: 50px;\r\n            font-size: 0.72rem;\r\n            font-weight: 600;\r\n            background: rgba(245, 158, 11, 0.12);\r\n            color: #fcd34d;\r\n            border: 1px solid rgba(245, 158, 11, 0.35);\r\n        }\r\n        .form-group {\r\n            margin-bottom: 18px;\r\n        }\r\n        .form-label {\r\n            display: block;\r\n            font-size: 0.82rem;\r\n            font-weight: 600;\r\n            color: #cbd5e1;\r\n            margin-bottom: 6px;\r\n        }\r\n        .form-input {\r\n            width: 100%;\r\n            padding: 11px 14px;\r\n            background-color: rgba(10, 12, 24, 0.75);\r\n            border: 1px solid rgba(255, 255, 255, 0.12);\r\n            border-radius: 8px;\r\n            color: #ffffff;\r\n            font-size: 0.88rem;\r\n            box-sizing: border-box;\r\n            transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;\r\n        }\r\n        .form-input:focus {\r\n            outline: none;\r\n            background-color: rgba(15, 18, 35, 0.95);\r\n            border-color: #f59e0b;\r\n            box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.25);\r\n        }\r\n        .form-input::placeholder {\r\n            color: #64748b;\r\n        }\r\n        .btn-submit {\r\n            width: 100%;\r\n            padding: 12px 18px;\r\n            background: var(--accent-grad);\r\n            color: #ffffff;\r\n            border: none;\r\n            border-radius: 8px;\r\n            font-size: 0.9rem;\r\n            font-weight: 600;\r\n            cursor: pointer;\r\n            transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;\r\n            margin-top: 10px;\r\n            box-shadow: 0 4px 16px var(--accent-glow);\r\n        }\r\n        .btn-submit:hover:not(:disabled) {\r\n            opacity: 0.94;\r\n            transform: translateY(-1px);\r\n            box-shadow: 0 6px 20px rgba(245, 158, 11, 0.35);\r\n        }\r\n        .btn-submit:focus-visible {\r\n            outline: 2px solid #f59e0b;\r\n            outline-offset: 2px;\r\n        }\r\n        .btn-submit:disabled {\r\n            opacity: 0.6;\r\n            cursor: not-allowed;\r\n        }\r\n        .error-message {\r\n            display: none;\r\n            background-color: rgba(239, 68, 68, 0.15);\r\n            border: 1px solid rgba(239, 68, 68, 0.4);\r\n            color: #fca5a5;\r\n            padding: 11px 14px;\r\n            border-radius: 8px;\r\n            font-size: 0.84rem;\r\n            margin-bottom: 18px;\r\n            line-height: 1.4;\r\n        }\r\n        .login-footer {\r\n            margin-top: 28px;\r\n            text-align: center;\r\n            font-size: 0.75rem;\r\n            color: #64748b;\r\n            border-top: 1px solid rgba(255, 255, 255, 0.06);\r\n            padding-top: 16px;\r\n        }\r\n        /* Small screens: keep the card comfortable and touch-friendly */\r\n        @media (max-width: 480px) {\r\n            .login-card { padding: 28px 20px; }\r\n        }\r\n        /* Honor the OS reduced-motion preference (card transition, button lift) */\r\n        @media (prefers-reduced-motion: reduce) {\r\n            *, *::before, *::after {\r\n                transition-duration: 0.01ms !important;\r\n                animation-duration: 0.01ms !important;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"login-card\">\r\n        <div class=\"login-header\">\r\n            <div class=\"login-logo-wrap\">\r\n                <img src=\"/logo.svg\" alt=\"JunifyDB logo\" width=\"88\" height=\"88\" />\r\n            </div>\r\n            <h1 class=\"login-title\">JunifyDB Console</h1>\r\n            <p class=\"login-subtitle\">Sign in to manage your embedded database</p>\r\n            <span class=\"login-badge\">Dual-Engine &bull; Relational SQL + Non-Relational NoSQL</span>\r\n        </div>\r\n\r\n        <div id=\"errorMessage\" class=\"error-message\" role=\"alert\"></div>\r\n\r\n        <form id=\"loginForm\" novalidate>\r\n            <div class=\"form-group\">\r\n                <label class=\"form-label\" for=\"username\">Username</label>\r\n                <input class=\"form-input\" type=\"text\" id=\"username\" name=\"username\" value=\"admin\" autocomplete=\"username\" aria-label=\"Username\" placeholder=\"e.g. admin\">\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n                <label class=\"form-label\" for=\"password\">Password</label>\r\n                <input class=\"form-input\" type=\"password\" id=\"password\" name=\"password\" autocomplete=\"current-password\" aria-label=\"Password\" placeholder=\"••••••••\">\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n                <label class=\"form-label\" for=\"apiKey\">API Key (Optional)</label>\r\n                <input class=\"form-input\" type=\"password\" id=\"apiKey\" name=\"apiKey\" aria-label=\"API key, optional\" placeholder=\"Leave blank if disabled\">\r\n            </div>\r\n\r\n            <button type=\"submit\" class=\"btn-submit\" id=\"submitBtn\">Sign In</button>\r\n        </form>\r\n\r\n        <div class=\"login-footer\">\r\n            JunifyDB Embedded Dual-Engine Database &bull; Secure Console\r\n        </div>\r\n    </div>\r\n\r\n    <script>\r\n        // Hide the stale error banner when the page loads (e.g. back-navigation\r\n        // from the console keeps it in the DOM via bfcache otherwise).\r\n        window.addEventListener('pageshow', () => {\r\n            const errorEl = document.getElementById('errorMessage');\r\n            if (errorEl) { errorEl.style.display = 'none'; errorEl.textContent = ''; }\r\n            const btn = document.getElementById('submitBtn');\r\n            if (btn) { btn.disabled = false; btn.textContent = 'Sign In'; }\r\n        });\r\n\r\n        const getBasePath = () => {\r\n            let p = window.location.pathname;\r\n            if (p.endsWith('.html')) p = p.substring(0, p.lastIndexOf('/'));\r\n            while (p.endsWith('/')) p = p.slice(0, -1);\r\n            return p;\r\n        };\r\n        const BASE_PATH = getBasePath();\r\n        const API_LOGIN = BASE_PATH ? (BASE_PATH + '/api/auth/login') : '/api/auth/login';\r\n\r\n        function showError(msg) {\r\n            const errorEl = document.getElementById('errorMessage');\r\n            errorEl.textContent = msg;\r\n            errorEl.style.display = 'block';\r\n        }\r\n        function clearError() {\r\n            const errorEl = document.getElementById('errorMessage');\r\n            errorEl.textContent = '';\r\n            errorEl.style.display = 'none';\r\n        }\r\n        // Clear the banner as soon as the user edits any field.\r\n        ['username', 'password', 'apiKey'].forEach((id) =>\r\n            document.getElementById(id).addEventListener('input', clearError));\r\n        document.getElementById('loginForm').addEventListener('submit', handleLogin);\r\n\r\n        async function handleLogin(e) {\r\n            e.preventDefault();\r\n            const submitBtn = document.getElementById('submitBtn');\r\n            const errorEl = document.getElementById('errorMessage');\r\n            const username = document.getElementById('username').value.trim();\r\n            const password = document.getElementById('password').value;\r\n            const apiKey = document.getElementById('apiKey').value.trim();\r\n\r\n            errorEl.style.display = 'none';\r\n            submitBtn.disabled = true;\r\n            submitBtn.textContent = 'Signing in...';\r\n\r\n            // Client-side guard: an empty submit is a mistake, not an attack —\r\n            // catch it here so it never burns a server-side brute-force strike.\r\n            if (!password && !apiKey) {\r\n                submitBtn.disabled = false;\r\n                submitBtn.textContent = 'Sign In';\r\n                showError('Enter your password — or an API key — to sign in.');\r\n                document.getElementById('password').focus();\r\n                return;\r\n            }\r\n\r\n            try {\r\n                const res = await fetch(API_LOGIN, {\r\n                    method: 'POST',\r\n                    headers: { 'Content-Type': 'application/json' },\r\n                    body: JSON.stringify({ username, password, apiKey })\r\n                });\r\n\r\n                if (res.ok) {\r\n                    const data = await res.json().catch(() => ({}));\r\n                    const headerCsrf = res.headers.get('X-CSRF-Token');\r\n                    const csrf = data.csrfToken || headerCsrf;\r\n                    if (csrf) {\r\n                        sessionStorage.setItem('csrfToken', csrf);\r\n                    }\r\n                    if (data.session) {\r\n                        sessionStorage.setItem('session', data.session);\r\n                    }\r\n                    if (apiKey) {\r\n                        localStorage.setItem('apiKey', apiKey);\r\n                    }\r\n                    // Return the user to the deep-linked console view if ?next= is present\r\n                    const next = new URLSearchParams(location.search).get('next');\r\n                    const safeNext = (next && next.startsWith('/') && !next.startsWith('//')) ? next : null;\r\n                    window.location.href = safeNext || (BASE_PATH ? (BASE_PATH + '/index.html') : 'index.html');\r\n                } else {\r\n                    const err = await res.json().catch(() => ({ message: 'Sign in failed' }));\r\n                    if (res.status === 429) {\r\n                        // Brute-force lockout: disable the form and count down\r\n                        // using the server's Retry-After header (seconds).\r\n                        const retryAfter = parseInt(res.headers.get('Retry-After'), 10);\r\n                        startLockoutCountdown(Number.isFinite(retryAfter) && retryAfter > 0 ? retryAfter : err.message);\r\n                    } else {\r\n                        showError(err.message || 'Invalid username or password. Check your credentials or API key.');\r\n                    }\r\n                }\r\n            } catch (err) {\r\n                // Network failure is NOT an auth result — never fake a redirect.\r\n                console.error('Login request failed:', err);\r\n                showError('Cannot reach the server. Check that JunifyDB is running and try again.');\r\n            } finally {\r\n                if (!lockoutTimer) {\r\n                    submitBtn.disabled = false;\r\n                    submitBtn.textContent = 'Sign In';\r\n                }\r\n            }\r\n        }\r\n\r\n        /* ---------------- lockout countdown ---------------- */\r\n        let lockoutTimer = null;\r\n\r\n        function startLockoutCountdown(secondsOrMessage) {\r\n            const submitBtn = document.getElementById('submitBtn');\r\n            // Server did not send a numeric Retry-After: show a static message.\r\n            if (typeof secondsOrMessage === 'string') {\r\n                showError(secondsOrMessage);\r\n                return;\r\n            }\r\n            let remaining = secondsOrMessage;\r\n            const tick = () => {\r\n                if (remaining <= 0) {\r\n                    clearInterval(lockoutTimer);\r\n                    lockoutTimer = null;\r\n                    submitBtn.disabled = false;\r\n                    submitBtn.textContent = 'Sign In';\r\n                    clearError();\r\n                    document.getElementById('password').focus();\r\n                    return;\r\n                }\r\n                submitBtn.disabled = true;\r\n                submitBtn.textContent = `Locked — retry in ${remaining}s`;\r\n                showError(`Too many failed attempts. You can try again in ${remaining} second${remaining === 1 ? '' : 's'}.`);\r\n                remaining--;\r\n            };\r\n            clearError();\r\n            tick();\r\n            lockoutTimer = setInterval(tick, 1000);\r\n        }\r\n    </script>\r\n</body>\r\n</html>\r\n"}