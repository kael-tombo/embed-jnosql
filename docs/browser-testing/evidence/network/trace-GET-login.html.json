{"method":"GET","url":"http://localhost:9090/jnosql-admin/login.html","requestBody":null,"statusCode":200,"responseHeaders":{"Status-Line":["HTTP/1.1 200 OK"],"Content-type":["text/html"],"Access-control-allow-origin":["*"],"Access-control-allow-headers":["Content-Type, X-API-Key, Authorization, Cookie, X-CSRF-Token"],"X-frame-options":["DENY"],"Referrer-policy":["strict-origin-when-cross-origin"],"Content-length":["13787"],"X-content-type-options":["nosniff"],"Date":["Wed, 07 Oct 2026 07:52:31 GMT"],"Content-security-policy":["default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"],"Access-control-allow-methods":["GET, POST, PUT, DELETE, OPTIONS"],"X-xss-protection":["1; mode=block"]},"responseBody":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>EmbedJNoSQL — Sign In</title>\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">\n    <link rel=\"stylesheet\" href=\"/css/enhancements.css\">\n    <style>\n        :root {\n            --bg-base: #090914;\n            --bg-card: rgba(18, 20, 38, 0.85);\n            --border-card: rgba(255, 255, 255, 0.08);\n            --accent-grad: linear-gradient(135deg, #fbbf24, #f59e0b);\n            --accent-glow: rgba(251, 191, 36, 0.25);\n            --text-main: #f8fafc;\n            --text-sub: #94a3b8;\n        }\n        body {\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            min-height: 100vh;\n            background: radial-gradient(circle at 50% 20%, rgba(245, 158, 11, 0.10) 0%, transparent 60%), #090914;\n            font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\n            color: var(--text-main);\n            margin: 0;\n            padding: 24px;\n            box-sizing: border-box;\n        }\n        .login-card {\n            background: var(--bg-card);\n            backdrop-filter: blur(16px);\n            -webkit-backdrop-filter: blur(16px);\n            border: 1px solid var(--border-card);\n            border-radius: 16px;\n            width: 100%;\n            max-width: 420px;\n            padding: 36px 32px;\n            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.05);\n            transition: transform 0.2s ease, box-shadow 0.2s ease;\n        }\n        .login-header {\n            text-align: center;\n            margin-bottom: 28px;\n        }\n        .login-logo-wrap {\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 18px;\n            filter: drop-shadow(0 8px 24px var(--accent-glow));\n        }\n        .login-title {\n            font-size: 1.6rem;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n            color: #ffffff;\n            margin: 0 0 6px 0;\n        }\n        .login-subtitle {\n            font-size: 0.85rem;\n            color: var(--text-sub);\n            margin: 0;\n        }\n        .login-badge {\n            display: inline-block;\n            margin-top: 8px;\n            padding: 3px 10px;\n            border-radius: 50px;\n            font-size: 0.72rem;\n            font-weight: 600;\n            background: rgba(245, 158, 11, 0.12);\n            color: #fcd34d;\n            border: 1px solid rgba(245, 158, 11, 0.35);\n        }\n        .form-group {\n            margin-bottom: 18px;\n        }\n        .form-label {\n            display: block;\n            font-size: 0.82rem;\n            font-weight: 600;\n            color: #cbd5e1;\n            margin-bottom: 6px;\n        }\n        .form-input {\n            width: 100%;\n            padding: 11px 14px;\n            background-color: rgba(10, 12, 24, 0.75);\n            border: 1px solid rgba(255, 255, 255, 0.12);\n            border-radius: 8px;\n            color: #ffffff;\n            font-size: 0.88rem;\n            box-sizing: border-box;\n            transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;\n        }\n        .form-input:focus {\n            outline: none;\n            background-color: rgba(15, 18, 35, 0.95);\n            border-color: #f59e0b;\n            box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.25);\n        }\n        .form-input::placeholder {\n            color: #64748b;\n        }\n        .btn-submit {\n            width: 100%;\n            padding: 12px 18px;\n            background: var(--accent-grad);\n            color: #ffffff;\n            border: none;\n            border-radius: 8px;\n            font-size: 0.9rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;\n            margin-top: 10px;\n            box-shadow: 0 4px 16px var(--accent-glow);\n        }\n        .btn-submit:hover:not(:disabled) {\n            opacity: 0.94;\n            transform: translateY(-1px);\n            box-shadow: 0 6px 20px rgba(245, 158, 11, 0.35);\n        }\n        .btn-submit:focus-visible {\n            outline: 2px solid #f59e0b;\n            outline-offset: 2px;\n        }\n        .btn-submit:disabled {\n            opacity: 0.6;\n            cursor: not-allowed;\n        }\n        .error-message {\n            display: none;\n            background-color: rgba(239, 68, 68, 0.15);\n            border: 1px solid rgba(239, 68, 68, 0.4);\n            color: #fca5a5;\n            padding: 11px 14px;\n            border-radius: 8px;\n            font-size: 0.84rem;\n            margin-bottom: 18px;\n            line-height: 1.4;\n        }\n        .login-footer {\n            margin-top: 28px;\n            text-align: center;\n            font-size: 0.75rem;\n            color: #64748b;\n            border-top: 1px solid rgba(255, 255, 255, 0.06);\n            padding-top: 16px;\n        }\n        /* Small screens: keep the card comfortable and touch-friendly */\n        @media (max-width: 480px) {\n            .login-card { padding: 28px 20px; }\n        }\n        /* Honor the OS reduced-motion preference (card transition, button lift) */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                transition-duration: 0.01ms !important;\n                animation-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"login-card\">\n        <div class=\"login-header\">\n            <div class=\"login-logo-wrap\">\n                <img src=\"/logo.svg\" alt=\"EmbedJNoSQL logo\" width=\"88\" height=\"88\" />\n            </div>\n            <h1 class=\"login-title\">EmbedJNoSQL Console</h1>\n            <p class=\"login-subtitle\">Sign in to manage your embedded database</p>\n            <span class=\"login-badge\">Dual-Engine &bull; Relational SQL + Non-Relational NoSQL</span>\n        </div>\n\n        <div id=\"errorMessage\" class=\"error-message\" role=\"alert\"></div>\n\n        <form id=\"loginForm\" novalidate>\n            <div class=\"form-group\">\n                <label class=\"form-label\" for=\"username\">Username</label>\n                <input class=\"form-input\" type=\"text\" id=\"username\" name=\"username\" value=\"admin\" autocomplete=\"username\" aria-label=\"Username\" placeholder=\"e.g. admin\">\n            </div>\n\n            <div class=\"form-group\">\n                <label class=\"form-label\" for=\"password\">Password</label>\n                <input class=\"form-input\" type=\"password\" id=\"password\" name=\"password\" autocomplete=\"current-password\" aria-label=\"Password\" placeholder=\"••••••••\">\n            </div>\n\n            <div class=\"form-group\">\n                <label class=\"form-label\" for=\"apiKey\">API Key (Optional)</label>\n                <input class=\"form-input\" type=\"password\" id=\"apiKey\" name=\"apiKey\" aria-label=\"API key, optional\" placeholder=\"Leave blank if disabled\">\n            </div>\n\n            <button type=\"submit\" class=\"btn-submit\" id=\"submitBtn\">Sign In</button>\n        </form>\n\n        <div class=\"login-footer\">\n            EmbedJNoSQL Embedded Dual-Engine Database &bull; Secure Console\n        </div>\n    </div>\n\n    <script>\n        // Hide the stale error banner when the page loads (e.g. back-navigation\n        // from the console keeps it in the DOM via bfcache otherwise).\n        window.addEventListener('pageshow', () => {\n            const errorEl = document.getElementById('errorMessage');\n            if (errorEl) { errorEl.style.display = 'none'; errorEl.textContent = ''; }\n            const btn = document.getElementById('submitBtn');\n            if (btn) { btn.disabled = false; btn.textContent = 'Sign In'; }\n        });\n\n        const getBasePath = () => {\n            let p = window.location.pathname;\n            if (p.endsWith('.html')) p = p.substring(0, p.lastIndexOf('/'));\n            while (p.endsWith('/')) p = p.slice(0, -1);\n            return p;\n        };\n        const BASE_PATH = getBasePath();\n        const API_LOGIN = BASE_PATH ? (BASE_PATH + '/api/auth/login') : '/api/auth/login';\n\n        function showError(msg) {\n            const errorEl = document.getElementById('errorMessage');\n            errorEl.textContent = msg;\n            errorEl.style.display = 'block';\n        }\n        function clearError() {\n            const errorEl = document.getElementById('errorMessage');\n            errorEl.textContent = '';\n            errorEl.style.display = 'none';\n        }\n        // Clear the banner as soon as the user edits any field.\n        ['username', 'password', 'apiKey'].forEach((id) =>\n            document.getElementById(id).addEventListener('input', clearError));\n        document.getElementById('loginForm').addEventListener('submit', handleLogin);\n\n        async function handleLogin(e) {\n            e.preventDefault();\n            const submitBtn = document.getElementById('submitBtn');\n            const errorEl = document.getElementById('errorMessage');\n            const username = document.getElementById('username').value.trim();\n            const password = document.getElementById('password').value;\n            const apiKey = document.getElementById('apiKey').value.trim();\n\n            errorEl.style.display = 'none';\n            submitBtn.disabled = true;\n            submitBtn.textContent = 'Signing in...';\n\n            // Client-side guard: an empty submit is a mistake, not an attack —\n            // catch it here so it never burns a server-side brute-force strike.\n            if (!password && !apiKey) {\n                submitBtn.disabled = false;\n                submitBtn.textContent = 'Sign In';\n                showError('Enter your password — or an API key — to sign in.');\n                document.getElementById('password').focus();\n                return;\n            }\n\n            try {\n                const res = await fetch(API_LOGIN, {\n                    method: 'POST',\n                    headers: { 'Content-Type': 'application/json' },\n                    body: JSON.stringify({ username, password, apiKey })\n                });\n\n                if (res.ok) {\n                    const data = await res.json().catch(() => ({}));\n                    const headerCsrf = res.headers.get('X-CSRF-Token');\n                    const csrf = data.csrfToken || headerCsrf;\n                    if (csrf) {\n                        sessionStorage.setItem('csrfToken', csrf);\n                    }\n                    if (data.session) {\n                        sessionStorage.setItem('session', data.session);\n                    }\n                    if (apiKey) {\n                        localStorage.setItem('apiKey', apiKey);\n                    }\n                    // Return the user to the deep-linked console view if ?next= is present\n                    const next = new URLSearchParams(location.search).get('next');\n                    const safeNext = (next && next.startsWith('/') && !next.startsWith('//')) ? next : null;\n                    window.location.href = safeNext || (BASE_PATH ? (BASE_PATH + '/index.html') : 'index.html');\n                } else {\n                    const err = await res.json().catch(() => ({ message: 'Sign in failed' }));\n                    if (res.status === 429) {\n                        // Brute-force lockout: disable the form and count down\n                        // using the server's Retry-After header (seconds).\n                        const retryAfter = parseInt(res.headers.get('Retry-After'), 10);\n                        startLockoutCountdown(Number.isFinite(retryAfter) && retryAfter > 0 ? retryAfter : err.message);\n                    } else {\n                        showError(err.message || 'Invalid username or password. Check your credentials or API key.');\n                    }\n                }\n            } catch (err) {\n                // Network failure is NOT an auth result — never fake a redirect.\n                console.error('Login request failed:', err);\n                showError('Cannot reach the server. Check that EmbedJNoSQL is running and try again.');\n            } finally {\n                if (!lockoutTimer) {\n                    submitBtn.disabled = false;\n                    submitBtn.textContent = 'Sign In';\n                }\n            }\n        }\n\n        /* ---------------- lockout countdown ---------------- */\n        let lockoutTimer = null;\n\n        function startLockoutCountdown(secondsOrMessage) {\n            const submitBtn = document.getElementById('submitBtn');\n            // Server did not send a numeric Retry-After: show a static message.\n            if (typeof secondsOrMessage === 'string') {\n                showError(secondsOrMessage);\n                return;\n            }\n            let remaining = secondsOrMessage;\n            const tick = () => {\n                if (remaining <= 0) {\n                    clearInterval(lockoutTimer);\n                    lockoutTimer = null;\n                    submitBtn.disabled = false;\n                    submitBtn.textContent = 'Sign In';\n                    clearError();\n                    document.getElementById('password').focus();\n                    return;\n                }\n                submitBtn.disabled = true;\n                submitBtn.textContent = `Locked — retry in ${remaining}s`;\n                showError(`Too many failed attempts. You can try again in ${remaining} second${remaining === 1 ? '' : 's'}.`);\n                remaining--;\n            };\n            clearError();\n            tick();\n            lockoutTimer = setInterval(tick, 1000);\n        }\n    </script>\n</body>\n</html>\n"}