{"method":"GET","url":"http://localhost:9090/jnosql-admin/","requestBody":null,"statusCode":200,"responseHeaders":{"Status-Line":["HTTP/1.1 200 OK"],"Content-type":["text/html"],"Access-control-allow-origin":["*"],"Access-control-allow-headers":["Content-Type, X-API-Key, Authorization, Cookie, X-CSRF-Token"],"X-frame-options":["DENY"],"Referrer-policy":["strict-origin-when-cross-origin"],"Content-length":["28760"],"X-content-type-options":["nosniff"],"Date":["Wed, 07 Oct 2026 07:52:31 GMT"],"Content-security-policy":["default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"],"Access-control-allow-methods":["GET, POST, PUT, DELETE, OPTIONS"],"X-xss-protection":["1; mode=block"]},"responseBody":"<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"dark\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>EmbedJNoSQL Console — Embedded Admin UI</title>\n  <meta name=\"description\" content=\"EmbedJNoSQL embedded NoSQL Console: inspect and operate document collections, key-value data, and wide-column families in your embedded database.\">\n  <link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">\n  <link rel=\"stylesheet\" href=\"/css/console.css\">\n</head>\n<body>\n  <!-- Shared brand glyph: reused by empty states (aria-hidden). -->\n  <svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\" focusable=\"false\">\n    <defs>\n      <g id=\"brand-mark\">\n        <rect x=\"4\" y=\"4\" width=\"40\" height=\"40\" rx=\"12\" fill=\"#0b2a52\"/>\n        <rect x=\"4\" y=\"4\" width=\"40\" height=\"40\" rx=\"12\" fill=\"none\" stroke=\"#1d4ed8\" stroke-width=\"1.5\"/>\n        <path d=\"M24 12l-8 12h5l-2 12 11-15h-6z\" fill=\"#fbbf24\"/>\n      </g>\n    </defs>\n  </svg>\n  <div id=\"app\">\n    <!-- ================= Brand ================= -->\n    <header class=\"brand\">\n      <span class=\"brand-tile\" aria-hidden=\"true\">\n        <img src=\"/logo.svg\" alt=\"\">\n      </span>\n      <div>\n        <div class=\"brand-name\">Jembed<em>DB</em></div>\n        <div class=\"brand-sub\">Console</div>\n      </div>\n    </header>\n\n    <!-- ================= Topbar ================= -->\n    <div class=\"topbar\">\n      <div>\n        <nav class=\"crumbs\" id=\"crumbs\" aria-label=\"Breadcrumb\"></nav>\n        <div class=\"topbar-title\" id=\"panelTitle\">Overview</div>\n        <div class=\"topbar-sub\" id=\"panelSub\">Database at a glance</div>\n      </div>\n      <div class=\"topbar-spacer\"></div>\n      <span class=\"topbar-chip\" id=\"chipHealth\"><span class=\"dot\"></span><span id=\"chipHealthText\">…</span></span>\n      <span class=\"topbar-chip\"><span id=\"chipEngine\">—</span></span>\n      <span class=\"topbar-chip\" title=\"Server build version (from the jar manifest)\"><span id=\"chipVersion\">v—</span></span>\n      <span class=\"topbar-chip\"><span id=\"chipUptime\">—</span></span>\n      <button class=\"icon-btn\" id=\"btnTheme\" title=\"Toggle theme\">◐</button>\n      <button class=\"icon-btn\" id=\"btnRefreshAll\" title=\"Refresh data (R)\">⟳</button>\n      <button class=\"btn sm\" id=\"btnHelp\" title=\"Open help, shortcuts, and engine documentation\">?</button>\n      <button class=\"btn sm\" id=\"btnLogout\" title=\"End session and return to sign-in\">Sign out</button>\n    </div>\n\n    <!-- ================= Status bar (always visible) =================\n         Every label here is fed from GET /api/health `context`, which reads the\n         live configuration — never from a guess in the front end. -->\n    <div class=\"statusbar\" id=\"statusbar\" role=\"status\" aria-label=\"Active database context\">\n      <span class=\"sb-item\" id=\"sbEngine\" title=\"Storage engine type\">engine —</span>\n      <span class=\"sb-sep\" aria-hidden=\"true\"></span>\n      <span class=\"sb-item\" id=\"sbStorage\" title=\"Storage mode and durability guarantee\">storage —</span>\n      <span class=\"sb-sep\" aria-hidden=\"true\"></span>\n      <span class=\"sb-item\" id=\"sbDatabase\" title=\"Active database / data directory\">database —</span>\n      <span class=\"sb-sep\" aria-hidden=\"true\"></span>\n      <span class=\"sb-item\" id=\"sbConnection\" title=\"Console-to-engine connection status\">connection —</span>\n      <span class=\"sb-sep\" aria-hidden=\"true\"></span>\n      <span class=\"sb-item\" id=\"sbTx\" title=\"Active transactions and whether Console writes are transactional\">tx —</span>\n      <span class=\"sb-sep\" aria-hidden=\"true\"></span>\n      <span class=\"sb-item\" id=\"sbUser\" title=\"Security context for the current session\">user —</span>\n      <span class=\"sb-spacer\"></span>\n      <span class=\"sb-item sb-context\" id=\"sbContext\" title=\"Active panel context (collection or schema)\">context: none</span>\n    </div>\n\n    <!-- ================= Sidebar ================= -->\n    <nav class=\"nav\" id=\"nav\" aria-label=\"Console navigation\">\n      <div class=\"nav-search-wrap\">\n        <input type=\"text\" id=\"navSearch\" class=\"nav-search\" placeholder=\"Filter pages…\"\n               aria-label=\"Filter navigation pages\" autocomplete=\"off\">\n      </div>\n    </nav>\n    <a class=\"skip-link\" href=\"#main\">Skip to main content</a>\n\n    <!-- ================= Main ================= -->\n    <main id=\"main\">\n\n      <!-- ========== OVERVIEW (shared) ========== -->\n      <section class=\"panel\" id=\"panel-overview\">\n        <div class=\"panel-head\">\n          <h1>Overview <span class=\"engine-tag nosql\" title=\"Embedded NoSQL engine\">NoSQL</span></h1>\n          <span class=\"hint\">Live counters, health, and engine info</span>\n        </div>\n        <div class=\"grid kpi\" id=\"kpiRow\"></div>\n\n        <div class=\"grid cols-2\" style=\"margin-top:16px\">\n          <div class=\"card\">\n            <div class=\"card-head\"><h2>Throughput (ops/s)</h2><div class=\"spacer\"></div><span class=\"badge\" id=\"sparkNow\">0</span></div>\n            <div class=\"card-pad\"><svg class=\"spark\" id=\"opsSpark\" viewBox=\"0 0 600 40\" preserveAspectRatio=\"none\"></svg></div>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-head\"><h2>Engine</h2></div>\n            <div class=\"card-pad\" id=\"engineInfo\"><div class=\"loading-row\"><span class=\"spinner\"></span>Loading engine info…</div></div>\n          </div>\n        </div>\n\n        <div class=\"card\" style=\"margin-top:16px\">\n          <div class=\"card-head\">\n            <h2>Storage &amp; WAL</h2>\n            <div class=\"spacer\"></div>\n            <span class=\"hint\">Live engine/durability truth — same source as the status bar</span>\n            <button class=\"btn sm\" id=\"ovStorageRefresh\" title=\"Reload storage and WAL status\">⟳</button>\n          </div>\n          <div class=\"card-pad\" id=\"ovStorage\"><div class=\"loading-row\"><span class=\"spinner\"></span>Loading storage status…</div></div>\n        </div>\n\n        <div class=\"grid cols-2\" style=\"margin-top:16px\">\n          <div class=\"card\">\n            <div class=\"card-head\"><h2>Collections</h2><div class=\"spacer\"></div><button class=\"btn sm\" data-goto=\"collections\">Open</button></div>\n            <div class=\"card-pad\" id=\"ovCollections\"><div class=\"loading-row\"><span class=\"spinner\"></span>Loading collections…</div></div>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-head\"><h2>Recent audit events</h2><div class=\"spacer\"></div><button class=\"btn sm\" data-goto=\"audit\">Open</button></div>\n            <div class=\"card-pad\" id=\"ovAudit\"><div class=\"loading-row\"><span class=\"spinner\"></span>Loading audit events…</div></div>\n          </div>\n        </div>\n      </section>\n\n      <!-- ========== COLLECTIONS (Non-Relational NoSQL Engine) ========== -->\n      <section class=\"panel\" id=\"panel-collections\">\n        <div class=\"panel-head\">\n          <h1>Collections <span class=\"engine-tag nosql\" title=\"NoSQL — document model\">NoSQL</span></h1>\n          <span class=\"hint\">Documents — create, inspect, edit, TTL, and schema</span>\n        </div>\n        <div class=\"card\">\n          <div class=\"card-head\">\n            <h2>All collections</h2>\n            <div class=\"spacer\"></div>\n            <button class=\"btn sm\" id=\"colRefresh\">Refresh</button>\n            <button class=\"btn primary sm\" id=\"colNew\">+ New document</button>\n          </div>\n          <div class=\"card-pad\" style=\"display:flex;gap:8px;flex-wrap:wrap\">\n            <input type=\"text\" id=\"colSel\" placeholder=\"collection name (e.g. users)\" style=\"max-width:240px\">\n            <button class=\"btn sm\" id=\"colLoad\">Load</button>\n            <span class=\"badge\" id=\"colCount\"></span>\n            <div class=\"spacer\"></div>\n            <button class=\"btn sm\" id=\"colCleanup\">Clean expired</button>\n            <button class=\"btn sm danger\" id=\"colDrop\">Drop all docs</button>\n          </div>\n          <div class=\"tbl-wrap\" id=\"colTable\"></div>\n        </div>\n        <div class=\"grid cols-2\" style=\"margin-top:16px\">\n          <div class=\"card\">\n            <div class=\"card-head\">\n              <h2>Insert / replace document</h2>\n              <div class=\"spacer\"></div>\n              <button class=\"btn sm\" id=\"colPickerRefresh\" title=\"Refresh the collection list from the engine\">⟳</button>\n            </div>\n            <div class=\"card-pad\" style=\"padding-bottom:6px\">\n              <div id=\"colPicker\" class=\"chip-row\" aria-label=\"Known collections\"></div>\n            </div>\n            <div class=\"card-pad\">\n              <label class=\"fld\">Collection</label>\n              <input type=\"text\" id=\"insCol\" placeholder=\"users\">\n              <label class=\"fld\" style=\"margin-top:10px\">Document JSON</label>\n              <textarea id=\"insJson\" rows=\"6\" placeholder='{\"id\":\"u1\",\"name\":\"Ada\",\"role\":\"admin\"}'></textarea>\n              <div style=\"display:flex;gap:8px;margin-top:10px\">\n                <button class=\"btn primary sm\" id=\"insSubmit\">Insert</button>\n                <span class=\"badge\" id=\"insStatus\"></span>\n              </div>\n            </div>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-head\">\n              <h2>Document detail</h2>\n              <div class=\"spacer\"></div>\n              <div class=\"view-toggle\" role=\"group\" aria-label=\"Document view mode\">\n                <button class=\"btn sm active\" id=\"docViewJson\" aria-pressed=\"true\">JSON</button>\n                <button class=\"btn sm\" id=\"docViewTree\" aria-pressed=\"false\">Tree</button>\n              </div>\n            </div>\n            <div class=\"card-pad\" id=\"docDetail\"><span class=\"empty\" style=\"padding:12px\"><svg class=\"empty-logo\" aria-hidden=\"true\"><use href=\"#brand-mark\"/></svg><br>No document selected — click a row in the table to inspect it.</span></div>\n          </div>\n          </div>\n        <div class=\"card\" style=\"margin-top:16px\">\n          <div class=\"card-head\">\n            <h2>Query builder</h2>\n            <div class=\"spacer\"></div>\n            <span class=\"badge\" id=\"qbStatus\" data-scope=\"Query builder\"></span>\n            <button class=\"btn sm\" id=\"qbRun\">Run filter</button>\n          </div>\n          <div class=\"card-pad\" id=\"qbBody\">\n            <div class=\"hint\" style=\"margin-bottom:8px\">Builds a filter for the engine's QueryParser. Supported operators: $eq · $ne · $gt · $gte · $lt · $lte · $in · $nin · $regex · $exists, combined with $and / $or. Regex is substring matching; anchor with ^ and $ deliberately.</div>\n            <div id=\"qbRows\"></div>\n            <div style=\"display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;align-items:flex-end\">\n              <div><label class=\"fld\" for=\"qbSortField\">Sort by (optional)</label><input type=\"text\" id=\"qbSortField\" placeholder=\"field\" style=\"width:140px\"></div>\n              <div><label class=\"fld\" for=\"qbSortDir\">Direction</label>\n                <select id=\"qbSortDir\" style=\"width:100px\"><option value=\"asc\">ascending</option><option value=\"desc\">descending</option></select></div>\n              <div><label class=\"fld\" for=\"qbLimit\">Limit</label><input type=\"number\" id=\"qbLimit\" value=\"100\" min=\"1\" style=\"width:90px\"></div>\n              <div><label class=\"fld\" for=\"qbOffset\">Offset</label><input type=\"number\" id=\"qbOffset\" value=\"0\" min=\"0\" style=\"width:90px\"></div>\n              <div class=\"spacer\"></div>\n              <button class=\"btn sm\" id=\"qbAddRow\">+ Add condition</button>\n              <button class=\"btn sm\" id=\"qbClear\">Clear</button>\n            </div>\n            <div class=\"card-pad\" style=\"padding:10px 0 0\">\n              <label class=\"fld\" for=\"qbPreview\">Query preview (JSON sent to the engine)</label>\n              <pre class=\"code json\" id=\"qbPreview\" style=\"max-height:120px\"></pre>\n            </div>\n            <div class=\"card-pad\" style=\"padding-top:0\"><div id=\"qbOut\"></div></div>\n            <div class=\"qb-pager\" id=\"qbPager\" hidden>\n              <button class=\"btn sm\" id=\"qbPrev\" title=\"Step the offset back by one page\">← Prev</button>\n              <span class=\"hint\" id=\"qbPageInfo\" aria-live=\"polite\"></span>\n              <button class=\"btn sm\" id=\"qbNext\" title=\"Advance the offset by one page\">Next →</button>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- ========== KV & REDIS STRUCTURES (Non-Relational NoSQL Engine) ========== -->\n      <section class=\"panel\" id=\"panel-kv\">\n        <div class=\"panel-head\">\n          <h1>Key-Value &amp; Redis Structures <span class=\"engine-tag nosql\" title=\"NoSQL — key-value model\">NoSQL</span></h1>\n          <span class=\"hint\">Simple KV, lists, sets, and hashes</span>\n        </div>\n        <div class=\"tabs\" id=\"kvTabs\" role=\"tablist\" aria-label=\"Key-value data structure kind\">\n          <button class=\"tab active\" data-kvtab=\"kv\" role=\"tab\" aria-selected=\"true\">KV browser</button>\n          <button class=\"tab\" data-kvtab=\"list\" role=\"tab\" aria-selected=\"false\">Lists</button>\n          <button class=\"tab\" data-kvtab=\"set\" role=\"tab\" aria-selected=\"false\">Sets</button>\n          <button class=\"tab\" data-kvtab=\"hash\" role=\"tab\" aria-selected=\"false\">Hashes</button>\n        </div>\n        <div class=\"card\" id=\"kvCard\">\n          <div class=\"card-head\"><h2 id=\"kvHead\">Simple KV</h2><div class=\"spacer\"></div><span class=\"badge\" id=\"kvStatus\"></span></div>\n          <div class=\"card-pad\" id=\"kvBody\"></div>\n        </div>\n      </section>\n\n      <!-- ========== COLUMN FAMILIES (Non-Relational NoSQL Engine) ========== -->\n      <section class=\"panel\" id=\"panel-columns\">\n        <div class=\"panel-head\">\n          <h1>Wide-Column Families <span class=\"engine-tag nosql\" title=\"NoSQL — wide-column model\">NoSQL</span></h1>\n          <span class=\"hint\">Row → column matrix with per-cell TTL</span>\n        </div>\n        <div class=\"card\">\n          <div class=\"card-head\">\n            <h2>Inspect</h2>\n            <div class=\"spacer\"></div>\n            <button class=\"btn primary sm\" id=\"cfPutBtn\">Put row</button>\n          </div>\n          <div class=\"card-pad\" style=\"display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end\">\n            <div><label class=\"fld\">Family</label><input type=\"text\" id=\"cfFam\" value=\"metrics\" style=\"width:160px\"></div>\n            <div><label class=\"fld\">Row key</label><input type=\"text\" id=\"cfRow\" placeholder=\"node-01\" style=\"width:180px\"></div>\n            <button class=\"btn sm\" id=\"cfGet\">Fetch row</button>\n            <button class=\"btn sm\" id=\"cfStats\">Family stats</button>\n          </div>\n          <div class=\"card-pad\" style=\"padding-top:0\"><div id=\"cfOut\"></div></div>\n          <div class=\"card-pad\" style=\"border-top:1px solid var(--line-0)\">\n            <div style=\"display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end\">\n              <div><label class=\"fld\">Row</label><input type=\"text\" id=\"cfPutRow\" style=\"width:160px\"></div>\n              <div><label class=\"fld\">Columns (JSON)</label><input type=\"text\" id=\"cfPutCols\" placeholder='{\"cpu\":\"42\"}' style=\"width:280px\"></div>\n              <button class=\"btn sm\" id=\"cfPutGo\">Write</button>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- ========== VECTORS (Non-Relational NoSQL Engine · EXPERIMENTAL) ========== -->\n      <section class=\"panel\" id=\"panel-vectors\">\n        <div class=\"panel-head\">\n          <h1>Vector Index (HNSW) <span class=\"engine-tag nosql\" title=\"NoSQL — vector model\">NoSQL</span></h1>\n          <span class=\"hint experimental\" title=\"Experimental feature: excluded from coverage gates; API may change\">⚠ Experimental — fixed 128 dimensions, API may change</span>\n        </div>\n        <div class=\"grid cols-2\">\n          <div class=\"card\">\n            <div class=\"card-head\"><h2>Index</h2></div>\n            <div class=\"card-pad\">\n              <label class=\"fld\">Index name</label>\n              <input type=\"text\" id=\"vecIdx\" value=\"embeddings\">\n              <div style=\"display:flex;gap:8px;margin-top:10px\">\n                <button class=\"btn sm\" id=\"vecInfo\">Info</button>\n                <span class=\"badge\" id=\"vecStatus\"></span>\n              </div>\n            </div>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-head\"><h2>Search (k-NN)</h2></div>\n            <div class=\"card-pad\">\n              <label class=\"fld\">Vector (JSON array — 128 dimensions, engine fixed)</label>\n              <input type=\"text\" id=\"vecQuery\" placeholder=\"[0.1, 0.2, ...]\">\n              <div style=\"display:flex;gap:8px;margin-top:10px;align-items:center\">\n                <label class=\"fld\" style=\"margin:0\">k</label>\n                <input type=\"number\" id=\"vecK\" value=\"5\" min=\"1\" style=\"width:70px\">\n                <button class=\"btn primary sm\" id=\"vecSearch\">Search</button>\n              </div>\n              <div style=\"margin-top:12px\"><div id=\"vecOut\"><div class=\"empty\"><svg class=\"empty-logo\" aria-hidden=\"true\"><use href=\"#brand-mark\"/></svg><br>No search yet — add vectors, then run a k-NN query.</div></div></div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- ========== SCHEMA (Non-Relational NoSQL Engine) ========== -->\n      <section class=\"panel\" id=\"panel-schema\">\n        <div class=\"panel-head\">\n          <h1>Schema Validation <span class=\"engine-tag nosql\" title=\"NoSQL — document validation\">NoSQL</span></h1>\n          <span class=\"hint\">Per-collection field schemas enforced on insert</span>\n        </div>\n        <div class=\"grid cols-2\">\n          <div class=\"card\">\n            <div class=\"card-head\"><h2>Registered schemas</h2><div class=\"spacer\"></div><button class=\"btn sm\" id=\"schRefresh\">Refresh</button></div>\n            <div class=\"card-pad\" id=\"schList\"><div class=\"loading-row\"><span class=\"spinner\"></span>Loading schemas…</div></div>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-head\"><h2>Define schema</h2></div>\n            <div class=\"card-pad\">\n              <label class=\"fld\">Collection</label>\n              <input type=\"text\" id=\"schCol\" placeholder=\"users\">\n              <label class=\"fld\" style=\"margin-top:10px\">Fields JSON — [{\"name\":\"role\",\"type\":\"String\",\"required\":true}]</label>\n              <textarea id=\"schFields\" rows=\"5\" placeholder='[{\"name\":\"name\",\"type\":\"String\",\"required\":true}]'></textarea>\n              <div style=\"display:flex;gap:8px;margin-top:10px;align-items:center\">\n                <button class=\"btn primary sm\" id=\"schSave\">Register</button>\n                <label style=\"font-size:12.5px;color:var(--text-1);display:flex;gap:6px;align-items:center\">\n                  <input type=\"checkbox\" id=\"schStrict\"> strict mode\n                </label>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- ========== TRANSACTIONS (shared) ========== -->\n      <section class=\"panel\" id=\"panel-tx\">\n        <div class=\"panel-head\">\n          <h1>Transactions <span class=\"engine-tag nosql\" title=\"Embedded NoSQL engine\">NoSQL</span></h1>\n          <span class=\"hint\">Begin, inspect, commit, or roll back active transactions (MVCC)</span>\n        </div>\n        <div class=\"card\" style=\"border-left: 3px solid var(--warn, #E8B923); margin-bottom: 12px;\">\n          <div style=\"font-size: 13px; line-height: 1.6;\">\n            <strong>Scope:</strong> this panel manages transaction <em>lifecycle</em> only. Console\n            CRUD — collection writes, bulk, and KV — writes directly to the\n            engine and is <strong>not</strong> governed by a transaction begun here, and no REST\n            write path currently accepts a transaction id. To put writes inside a transaction,\n            use the Java API (<code>db.beginTransaction()</code>).\n          </div>\n        </div>\n        <div class=\"card\">\n          <div class=\"card-head\">\n            <h2>Active</h2>\n            <div class=\"spacer\"></div>\n            <span class=\"badge\" id=\"txCount\"></span>\n            <button class=\"btn primary sm\" id=\"txBegin\">+ Begin transaction</button>\n          </div>\n          <div class=\"tbl-wrap\" id=\"txTable\"></div>\n        </div>\n      </section>\n\n      <!-- ========== INDEXES (Non-Relational NoSQL Engine) ========== -->\n      <section class=\"panel\" id=\"panel-indexes\">\n        <div class=\"panel-head\">\n          <h1>Secondary Indexes <span class=\"engine-tag nosql\" title=\"NoSQL — document indexes\">NoSQL</span></h1>\n          <span class=\"hint\">Per-collection field indexes</span>\n        </div>\n        <div class=\"card\">\n          <div class=\"card-head\">\n            <h2>Inspect / create</h2>\n            <div class=\"spacer\"></div>\n            <input type=\"text\" id=\"idxCol\" placeholder=\"collection\" style=\"max-width:200px\">\n            <button class=\"btn sm\" id=\"idxList\">List</button>\n          </div>\n          <div class=\"card-pad\" style=\"display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap\">\n            <div><label class=\"fld\">Field</label><input type=\"text\" id=\"idxField\" placeholder=\"email\" style=\"width:200px\"></div>\n            <button class=\"btn primary sm\" id=\"idxCreate\">Create index</button>\n            <span class=\"badge\" id=\"idxStatus\"></span>\n          </div>\n          <div class=\"card-pad\" style=\"padding-top:0\"><div id=\"idxOut\"></div></div>\n        </div>\n      </section>\n\n      <!-- ========== BACKUP (shared) ========== -->\n      <section class=\"panel\" id=\"panel-backup\">\n        <div class=\"panel-head\">\n          <h1>Backup &amp; Restore <span class=\"engine-tag nosql\" title=\"Embedded NoSQL engine\">NoSQL</span></h1>\n          <span class=\"hint\">Snapshot the data directory or restore from a backup file</span>\n        </div>\n        <div class=\"grid cols-2\">\n          <div class=\"card\">\n            <div class=\"card-head\"><h2>Status</h2><div class=\"spacer\"></div><button class=\"btn sm\" id=\"bkRefresh\">Refresh</button></div>\n            <div class=\"card-pad\" id=\"bkInfo\"><div class=\"loading-row\"><span class=\"spinner\"></span>Loading backup status…</div></div>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-head\"><h2>Actions</h2></div>\n            <div class=\"card-pad\">\n              <button class=\"btn primary\" id=\"bkCreate\">Create backup</button>\n              <div style=\"margin-top:14px\">\n                <label class=\"fld\">Restore from file path</label>\n                <input type=\"text\" id=\"bkFile\" placeholder=\"backups/backup-…\">\n                <button class=\"btn sm\" id=\"bkRestore\" style=\"margin-top:8px\">Restore</button>\n              </div>\n              <span class=\"badge\" id=\"bkStatus\"></span>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- ========== CDC & EVENTS (shared) ========== -->\n      <section class=\"panel\" id=\"panel-cdc\">\n        <div class=\"panel-head\">\n          <h1>Change Data Capture <span class=\"engine-tag nosql\" title=\"Embedded NoSQL engine\">NoSQL</span></h1>\n          <span class=\"hint\">Event log, connectors, and enable/disable</span>\n        </div>\n        <div class=\"grid cols-2\">\n          <div class=\"card\">\n            <div class=\"card-head\">\n              <h2>Status</h2><div class=\"spacer\"></div>\n              <span class=\"badge\" id=\"cdcState\"></span>\n              <button class=\"btn sm\" id=\"cdcToggle\">Toggle</button>\n            </div>\n            <div class=\"card-pad\" id=\"cdcStatus\"><div class=\"loading-row\"><span class=\"spinner\"></span>Loading CDC status…</div></div>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-head\"><h2>Connectors</h2><div class=\"spacer\"></div><button class=\"btn sm\" id=\"cdcRefresh\">Refresh</button></div>\n            <div class=\"card-pad\">\n              <div style=\"display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap\">\n                <div><label class=\"fld\">Name</label><input type=\"text\" id=\"cdcName\" placeholder=\"sink-1\" style=\"width:130px\"></div>\n                <div><label class=\"fld\">Type</label>\n                  <select id=\"cdcType\" style=\"width:110px\"><option value=\"file\">file</option><option value=\"kafka\">kafka</option></select>\n                </div>\n                <div><label class=\"fld\">Param (dir / servers)</label><input type=\"text\" id=\"cdcParam\" placeholder=\"target/cdc-out\" style=\"width:200px\"></div>\n                <button class=\"btn sm\" id=\"cdcAdd\">Connect</button>\n              </div>\n              <div style=\"margin-top:12px\"><div id=\"cdcConnectors\"><div class=\"empty\">No connectors configured.</div></div></div>\n            </div>\n          </div>\n        </div>\n        <div class=\"card\" style=\"margin-top:16px\">\n          <div class=\"card-head\"><h2>Event log</h2><div class=\"spacer\"></div><button class=\"btn sm\" id=\"cdcEvents\">Load events</button></div>\n          <div class=\"tbl-wrap\" id=\"cdcTable\"></div>\n        </div>\n      </section>\n\n      <!-- ========== AUDIT (shared) ========== -->\n      <section class=\"panel\" id=\"panel-audit\">\n        <div class=\"panel-head\">\n          <h1>Audit Trail <span class=\"engine-tag nosql\" title=\"Embedded NoSQL engine\">NoSQL</span></h1>\n          <span class=\"hint\">Recent mutating operations (bounded in-memory log)</span>\n        </div>\n        <div class=\"card\">\n          <div class=\"card-head\"><h2>Events</h2><div class=\"spacer\"></div><button class=\"btn sm\" id=\"audRefresh\">Refresh</button></div>\n          <div class=\"tbl-wrap\" id=\"audTable\"></div>\n        </div>\n      </section>\n\n      <!-- ========== SERVER (CLI / legacy) ========== -->\n      <section class=\"panel\" id=\"panel-server\">\n        <div class=\"panel-head\">\n          <h1>Server <span class=\"engine-tag nosql\" title=\"Embedded NoSQL engine\">NoSQL</span></h1>\n          <span class=\"hint\">Health details, JVM metrics, and connection info</span>\n        </div>\n        <div class=\"grid cols-2\">\n          <div class=\"card\">\n            <div class=\"card-head\"><h2>Health</h2><div class=\"spacer\"></div><button class=\"btn sm\" id=\"srvRefresh\">Refresh</button></div>\n            <div class=\"card-pad\"><pre class=\"code json\" id=\"srvHealth\"></pre></div>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-head\"><h2>JVM metrics</h2></div>\n            <div class=\"card-pad\"><pre class=\"code json\" id=\"srvMetrics\"></pre></div>\n          </div>\n        </div>\n      </section>\n\n    </main>\n  </div>\n\n  <div id=\"toasts\"></div>\n\n  <!-- ================= Help / shortcuts / documentation dialog ================= -->\n  <div class=\"modal-backdrop\" id=\"helpBackdrop\" hidden>\n    <div class=\"modal\" id=\"helpDialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"helpTitle\">\n      <div class=\"modal-head\">\n        <h2 id=\"helpTitle\">Help — keyboard shortcuts &amp; data-model reference</h2>\n      </div>\n      <div class=\"modal-body\" id=\"helpBody\">\n        <h3>Keyboard</h3>\n        <dl class=\"help-keys\">\n          <dt><kbd>1</kbd>–<kbd>9</kbd>, <kbd>0</kbd></dt><dd>Switch panels</dd>\n          <dt><kbd>Esc</kbd></dt><dd>Close a dialog / cancel destructive confirmation</dd>\n        </dl>\n        <h3>Data models</h3>\n        <p><strong>Documents</strong> (MongoDB-style filters\n        $eq $ne $gt $gte $lt $lte $in $nin $regex $exists, $and/$or), key-value buckets with TTL,\n        Redis-style lists/sets/hashes, wide-column families, HNSW vector search (experimental).\n        Secondary field indexes via the Indexes panel.</p>\n        <h3>Safety</h3>\n        <p>Destructive statements and actions always ask first and name their target. Console writes\n        do not join transactions begun in the Transactions panel — that boundary is stated in the\n        status bar, not hidden.</p>\n        <p class=\"help-meta\" id=\"helpVersion\"></p>\n      </div>\n      <div class=\"modal-foot\">\n        <span class=\"hint\">Documentation: docs/admin-console/ · docs/product/USER_STORY_MAP.md</span>\n        <div class=\"spacer\"></div>\n        <button class=\"btn sm\" id=\"helpClose\">Close</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ================= Confirmation dialog =================\n       Destructive actions name their target, quantify the impact, and state what\n       cannot be undone before anything is sent to the engine. -->\n  <div class=\"modal-backdrop\" id=\"confirmBackdrop\" hidden>\n    <div class=\"modal\" id=\"confirmDialog\" role=\"dialog\" aria-modal=\"true\"\n         aria-labelledby=\"confirmTitle\" aria-describedby=\"confirmBody\">\n      <div class=\"modal-head\">\n        <h2 id=\"confirmTitle\">Confirm action</h2>\n      </div>\n      <div class=\"modal-body\" id=\"confirmBody\"></div>\n      <div class=\"modal-foot\">\n        <span class=\"hint\" id=\"confirmHint\"></span>\n        <div class=\"spacer\"></div>\n        <button class=\"btn sm\" id=\"confirmCancel\">Cancel</button>\n        <button class=\"btn sm danger\" id=\"confirmAccept\">Confirm</button>\n      </div>\n    </div>\n  </div>\n\n  <script src=\"/js/console.js\"></script>\n</body>\n</html>\n"}