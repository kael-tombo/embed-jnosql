+{"method":"GET","url":"http://localhost:9090/jnosql-admin/","requestBody":null,"statusCode":200,"responseHeaders":{"Status-Line":["HTTP/1.1 200 OK"],"Content-type":["text/html"],"Access-control-allow-origin":["*"],"Access-control-allow-headers":["Content-Type, X-API-Key, Authorization, Cookie, X-CSRF-Token"],"X-frame-options":["DENY"],"Referrer-policy":["strict-origin-when-cross-origin"],"Content-length":["22255"],"X-content-type-options":["nosniff"],"Date":["Tue, 22 Sep 2026 10:20:01 GMT"],"Content-security-policy":["default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"],"Access-control-allow-methods":["GET, POST, PUT, DELETE, OPTIONS"],"X-xss-protection":["1; mode=block"]},"responseBody":"<!DOCTYPE html>\r\n<html lang=\"en\" data-theme=\"dark\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n  <title>JunifyDB Console — Embedded Admin UI</title>\r\n  <meta name=\"description\" content=\"JunifyDB embedded Console: manage collections, key-value data, and run Relational SQL queries against the embedded database.\">\r\n  <link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">\r\n  <link rel=\"stylesheet\" href=\"/css/console.css\">\r\n</head>\r\n<body>\r\n  <!-- Shared brand glyph: reused by empty states (aria-hidden). -->\r\n  <svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\" focusable=\"false\">\r\n    <defs>\r\n      <g id=\"brand-mark\">\r\n        <rect x=\"4\" y=\"4\" width=\"40\" height=\"40\" rx=\"12\" fill=\"#0b2a52\"/>\r\n        <rect x=\"4\" y=\"4\" width=\"40\" height=\"40\" rx=\"12\" fill=\"none\" stroke=\"#1d4ed8\" stroke-width=\"1.5\"/>\r\n        <path d=\"M24 12l-8 12h5l-2 12 11-15h-6z\" fill=\"#fbbf24\"/>\r\n      </g>\r\n    </defs>\r\n  </svg>\r\n  <div id=\"app\">\r\n    <!-- ================= Brand ================= -->\r\n    <header class=\"brand\">\r\n      <span class=\"brand-tile\" aria-hidden=\"true\">\r\n        <img src=\"/logo.svg\" alt=\"\">\r\n      </span>\r\n      <div>\r\n        <div class=\"brand-name\">Junify<em>DB</em></div>\r\n        <div class=\"brand-sub\">Console</div>\r\n      </div>\r\n    </header>\r\n\r\n    <!-- ================= Topbar ================= -->\r\n    <div class=\"topbar\">\r\n      <div>\r\n        <div class=\"topbar-title\" id=\"panelTitle\">Overview</div>\r\n        <div class=\"topbar-sub\" id=\"panelSub\">Database at a glance</div>\r\n      </div>\r\n      <div class=\"topbar-spacer\"></div>\r\n      <span class=\"topbar-chip\" id=\"chipHealth\"><span class=\"dot\"></span><span id=\"chipHealthText\">…</span></span>\r\n      <span class=\"topbar-chip\"><span id=\"chipEngine\">—</span></span>\r\n      <span class=\"topbar-chip\"><span id=\"chipUptime\">—</span></span>\r\n      <button class=\"icon-btn\" id=\"btnTheme\" title=\"Toggle theme\">◐</button>\r\n      <button class=\"icon-btn\" id=\"btnRefreshAll\" title=\"Refresh data (R)\">⟳</button>\r\n      <button class=\"btn sm\" id=\"btnLogout\" title=\"End session and return to sign-in\">Sign out</button>\r\n    </div>\r\n\r\n    <!-- ================= Sidebar ================= -->\r\n    <nav class=\"nav\" id=\"nav\"></nav>\r\n\r\n    <!-- ================= Main ================= -->\r\n    <main id=\"main\">\r\n\r\n      <!-- ========== OVERVIEW (shared) ========== -->\r\n      <section class=\"panel\" id=\"panel-overview\">\r\n        <div class=\"panel-head\">\r\n          <h1>Overview <span class=\"engine-tag shared\" title=\"Shared capability — both engines\">Both Engines</span></h1>\r\n          <span class=\"hint\">Live counters, health, and engine info</span>\r\n        </div>\r\n        <div class=\"grid kpi\" id=\"kpiRow\"></div>\r\n\r\n        <div class=\"grid cols-2\" style=\"margin-top:16px\">\r\n          <div class=\"card\">\r\n            <div class=\"card-head\"><h2>Throughput (ops/s)</h2><div class=\"spacer\"></div><span class=\"badge\" id=\"sparkNow\">0</span></div>\r\n            <div class=\"card-pad\"><svg class=\"spark\" id=\"opsSpark\" viewBox=\"0 0 600 40\" preserveAspectRatio=\"none\"></svg></div>\r\n          </div>\r\n          <div class=\"card\">\r\n            <div class=\"card-head\"><h2>Engine</h2></div>\r\n            <div class=\"card-pad\" id=\"engineInfo\"><div class=\"loading-row\"><span class=\"spinner\"></span>Loading engine info…</div></div>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"grid cols-2\" style=\"margin-top:16px\">\r\n          <div class=\"card\">\r\n            <div class=\"card-head\"><h2>Collections</h2><div class=\"spacer\"></div><button class=\"btn sm\" data-goto=\"collections\">Open</button></div>\r\n            <div class=\"card-pad\" id=\"ovCollections\"><div class=\"loading-row\"><span class=\"spinner\"></span>Loading collections…</div></div>\r\n          </div>\r\n          <div class=\"card\">\r\n            <div class=\"card-head\"><h2>Recent audit events</h2><div class=\"spacer\"></div><button class=\"btn sm\" data-goto=\"audit\">Open</button></div>\r\n            <div class=\"card-pad\" id=\"ovAudit\"><div class=\"loading-row\"><span class=\"spinner\"></span>Loading audit events…</div></div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- ========== SQL STUDIO (Relational SQL Engine) ========== -->\r\n      <section class=\"panel\" id=\"panel-sql\">\r\n        <div class=\"panel-head\">\r\n          <h1>SQL Studio <span class=\"engine-tag sql\" title=\"Relational SQL Engine — built-in SQL dialect\">Relational SQL Engine</span></h1>\r\n          <span class=\"hint\">Built-in dialect (SELECT · INSERT · UPDATE · DELETE · JOIN · GROUP BY) — <kbd>Ctrl</kbd>+<kbd>Enter</kbd> to run</span>\r\n        </div>\r\n        <div class=\"card\">\r\n          <div class=\"card-head\">\r\n            <h2>Editor</h2>\r\n            <div class=\"spacer\"></div>\r\n            <span class=\"badge\" id=\"sqlStatus\">idle</span>\r\n            <button class=\"btn sm\" id=\"sqlClear\">Clear</button>\r\n            <button class=\"btn primary sm\" id=\"sqlRun\">▸ Run</button>\r\n          </div>\r\n          <div class=\"card-pad\">\r\n            <textarea id=\"sqlInput\" rows=\"7\" spellcheck=\"false\"\r\n              placeholder=\"SELECT * FROM products WHERE price > 10 ORDER BY price DESC LIMIT 20\"></textarea>\r\n            <div style=\"display:flex;gap:6px;margin-top:10px;flex-wrap:wrap\" id=\"sqlExamples\"></div>\r\n          </div>\r\n          <div class=\"card-head\" style=\"border-top:1px solid var(--line-0);border-bottom:0\">\r\n            <h2>Results</h2>\r\n            <div class=\"spacer\"></div>\r\n            <span class=\"badge\" id=\"sqlMeta\"></span>\r\n            <button class=\"btn sm\" id=\"sqlCopy\">Copy JSON</button>\r\n          </div>\r\n          <div class=\"card-pad\" style=\"padding-top:0\"><div id=\"sqlOut\"><div class=\"empty\"><svg class=\"empty-logo\" aria-hidden=\"true\"><use href=\"#brand-mark\"/></svg><br>No query run yet — write SQL above and press <kbd>Ctrl</kbd>+<kbd>Enter</kbd>.</div></div></div>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- ========== COLLECTIONS (Non-Relational NoSQL Engine) ========== -->\r\n      <section class=\"panel\" id=\"panel-collections\">\r\n        <div class=\"panel-head\">\r\n          <h1>Collections <span class=\"engine-tag nosql\" title=\"Non-Relational NoSQL Engine — document model\">Non-Relational NoSQL Engine</span></h1>\r\n          <span class=\"hint\">Documents — create, inspect, edit, TTL, and schema</span>\r\n        </div>\r\n        <div class=\"card\">\r\n          <div class=\"card-head\">\r\n            <h2>All collections</h2>\r\n            <div class=\"spacer\"></div>\r\n            <button class=\"btn sm\" id=\"colRefresh\">Refresh</button>\r\n            <button class=\"btn primary sm\" id=\"colNew\">+ New document</button>\r\n          </div>\r\n          <div class=\"card-pad\" style=\"display:flex;gap:8px;flex-wrap:wrap\">\r\n            <input type=\"text\" id=\"colSel\" placeholder=\"collection name (e.g. users)\" style=\"max-width:240px\">\r\n            <button class=\"btn sm\" id=\"colLoad\">Load</button>\r\n            <span class=\"badge\" id=\"colCount\"></span>\r\n            <div class=\"spacer\"></div>\r\n            <button class=\"btn sm\" id=\"colCleanup\">Clean expired</button>\r\n            <button class=\"btn sm danger\" id=\"colDrop\">Drop all docs</button>\r\n          </div>\r\n          <div class=\"tbl-wrap\" id=\"colTable\"></div>\r\n        </div>\r\n        <div class=\"grid cols-2\" style=\"margin-top:16px\">\r\n          <div class=\"card\">\r\n            <div class=\"card-head\"><h2>Insert / replace document</h2></div>\r\n            <div class=\"card-pad\">\r\n              <label class=\"fld\">Collection</label>\r\n              <input type=\"text\" id=\"insCol\" placeholder=\"users\">\r\n              <label class=\"fld\" style=\"margin-top:10px\">Document JSON</label>\r\n              <textarea id=\"insJson\" rows=\"6\" placeholder='{\"id\":\"u1\",\"name\":\"Ada\",\"role\":\"admin\"}'></textarea>\r\n              <div style=\"display:flex;gap:8px;margin-top:10px\">\r\n                <button class=\"btn primary sm\" id=\"insSubmit\">Insert</button>\r\n                <span class=\"badge\" id=\"insStatus\"></span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div class=\"card\">\r\n            <div class=\"card-head\"><h2>Document detail</h2></div>\r\n            <div class=\"card-pad\" id=\"docDetail\"><span class=\"empty\" style=\"padding:12px\"><svg class=\"empty-logo\" aria-hidden=\"true\"><use href=\"#brand-mark\"/></svg><br>No document selected — click a row in the table to inspect it.</span></div>\r\n          </div>\r\n          </div>\r\n      </section>\r\n\r\n      <!-- ========== KV & REDIS STRUCTURES (Non-Relational NoSQL Engine) ========== -->\r\n      <section class=\"panel\" id=\"panel-kv\">\r\n        <div class=\"panel-head\">\r\n          <h1>Key-Value &amp; Redis Structures <span class=\"engine-tag nosql\" title=\"Non-Relational NoSQL Engine — key-value model\">Non-Relational NoSQL Engine</span></h1>\r\n          <span class=\"hint\">Simple KV, lists, sets, and hashes</span>\r\n        </div>\r\n        <div class=\"tabs\" id=\"kvTabs\">\r\n          <button class=\"tab active\" data-kvtab=\"kv\">KV</button>\r\n          <button class=\"tab\" data-kvtab=\"list\">Lists</button>\r\n          <button class=\"tab\" data-kvtab=\"set\">Sets</button>\r\n          <button class=\"tab\" data-kvtab=\"hash\">Hashes</button>\r\n        </div>\r\n        <div class=\"card\" id=\"kvCard\">\r\n          <div class=\"card-head\"><h2 id=\"kvHead\">Simple KV</h2><div class=\"spacer\"></div><span class=\"badge\" id=\"kvStatus\"></span></div>\r\n          <div class=\"card-pad\" id=\"kvBody\"></div>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- ========== COLUMN FAMILIES (Non-Relational NoSQL Engine) ========== -->\r\n      <section class=\"panel\" id=\"panel-columns\">\r\n        <div class=\"panel-head\">\r\n          <h1>Wide-Column Families <span class=\"engine-tag nosql\" title=\"Non-Relational NoSQL Engine — wide-column model\">Non-Relational NoSQL Engine</span></h1>\r\n          <span class=\"hint\">Row → column matrix with per-cell TTL</span>\r\n        </div>\r\n        <div class=\"card\">\r\n          <div class=\"card-head\">\r\n            <h2>Inspect</h2>\r\n            <div class=\"spacer\"></div>\r\n            <button class=\"btn primary sm\" id=\"cfPutBtn\">Put row</button>\r\n          </div>\r\n          <div class=\"card-pad\" style=\"display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end\">\r\n            <div><label class=\"fld\">Family</label><input type=\"text\" id=\"cfFam\" value=\"metrics\" style=\"width:160px\"></div>\r\n            <div><label class=\"fld\">Row key</label><input type=\"text\" id=\"cfRow\" placeholder=\"node-01\" style=\"width:180px\"></div>\r\n            <button class=\"btn sm\" id=\"cfGet\">Fetch row</button>\r\n            <button class=\"btn sm\" id=\"cfStats\">Family stats</button>\r\n          </div>\r\n          <div class=\"card-pad\" style=\"padding-top:0\"><div id=\"cfOut\"></div></div>\r\n          <div class=\"card-pad\" style=\"border-top:1px solid var(--line-0)\">\r\n            <div style=\"display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end\">\r\n              <div><label class=\"fld\">Row</label><input type=\"text\" id=\"cfPutRow\" style=\"width:160px\"></div>\r\n              <div><label class=\"fld\">Columns (JSON)</label><input type=\"text\" id=\"cfPutCols\" placeholder='{\"cpu\":\"42\"}' style=\"width:280px\"></div>\r\n              <button class=\"btn sm\" id=\"cfPutGo\">Write</button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- ========== VECTORS (Non-Relational NoSQL Engine · EXPERIMENTAL) ========== -->\r\n      <section class=\"panel\" id=\"panel-vectors\">\r\n        <div class=\"panel-head\">\r\n          <h1>Vector Index (HNSW) <span class=\"engine-tag nosql\" title=\"Non-Relational NoSQL Engine — vector model\">Non-Relational NoSQL Engine</span></h1>\r\n          <span class=\"hint experimental\" title=\"Experimental feature: excluded from coverage gates; API may change\">⚠ Experimental — fixed 128 dimensions, API may change</span>\r\n        </div>\r\n        <div class=\"grid cols-2\">\r\n          <div class=\"card\">\r\n            <div class=\"card-head\"><h2>Index</h2></div>\r\n            <div class=\"card-pad\">\r\n              <label class=\"fld\">Index name</label>\r\n              <input type=\"text\" id=\"vecIdx\" value=\"embeddings\">\r\n              <div style=\"display:flex;gap:8px;margin-top:10px\">\r\n                <button class=\"btn sm\" id=\"vecInfo\">Info</button>\r\n                <span class=\"badge\" id=\"vecStatus\"></span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div class=\"card\">\r\n            <div class=\"card-head\"><h2>Search (k-NN)</h2></div>\r\n            <div class=\"card-pad\">\r\n              <label class=\"fld\">Vector (JSON array — 128 dimensions, engine fixed)</label>\r\n              <input type=\"text\" id=\"vecQuery\" placeholder=\"[0.1, 0.2, ...]\">\r\n              <div style=\"display:flex;gap:8px;margin-top:10px;align-items:center\">\r\n                <label class=\"fld\" style=\"margin:0\">k</label>\r\n                <input type=\"number\" id=\"vecK\" value=\"5\" min=\"1\" style=\"width:70px\">\r\n                <button class=\"btn primary sm\" id=\"vecSearch\">Search</button>\r\n              </div>\r\n              <div style=\"margin-top:12px\"><div id=\"vecOut\"><div class=\"empty\"><svg class=\"empty-logo\" aria-hidden=\"true\"><use href=\"#brand-mark\"/></svg><br>No search yet — add vectors, then run a k-NN query.</div></div></div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- ========== SCHEMA (Non-Relational NoSQL Engine) ========== -->\r\n      <section class=\"panel\" id=\"panel-schema\">\r\n        <div class=\"panel-head\">\r\n          <h1>Schema Validation <span class=\"engine-tag nosql\" title=\"Non-Relational NoSQL Engine — document validation\">Non-Relational NoSQL Engine</span></h1>\r\n          <span class=\"hint\">Per-collection field schemas enforced on insert</span>\r\n        </div>\r\n        <div class=\"grid cols-2\">\r\n          <div class=\"card\">\r\n            <div class=\"card-head\"><h2>Registered schemas</h2><div class=\"spacer\"></div><button class=\"btn sm\" id=\"schRefresh\">Refresh</button></div>\r\n            <div class=\"card-pad\" id=\"schList\"><div class=\"loading-row\"><span class=\"spinner\"></span>Loading schemas…</div></div>\r\n          </div>\r\n          <div class=\"card\">\r\n            <div class=\"card-head\"><h2>Define schema</h2></div>\r\n            <div class=\"card-pad\">\r\n              <label class=\"fld\">Collection</label>\r\n              <input type=\"text\" id=\"schCol\" placeholder=\"users\">\r\n              <label class=\"fld\" style=\"margin-top:10px\">Fields JSON — [{\"name\":\"role\",\"type\":\"String\",\"required\":true}]</label>\r\n              <textarea id=\"schFields\" rows=\"5\" placeholder='[{\"name\":\"name\",\"type\":\"String\",\"required\":true}]'></textarea>\r\n              <div style=\"display:flex;gap:8px;margin-top:10px;align-items:center\">\r\n                <button class=\"btn primary sm\" id=\"schSave\">Register</button>\r\n                <label style=\"font-size:12.5px;color:var(--text-1);display:flex;gap:6px;align-items:center\">\r\n                  <input type=\"checkbox\" id=\"schStrict\"> strict mode\r\n                </label>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- ========== TRANSACTIONS (shared) ========== -->\r\n      <section class=\"panel\" id=\"panel-tx\">\r\n        <div class=\"panel-head\">\r\n          <h1>Transactions <span class=\"engine-tag shared\" title=\"Shared capability — both engines\">Both Engines</span></h1>\r\n          <span class=\"hint\">Begin, inspect, commit, or roll back active transactions (MVCC)</span>\r\n        </div>\r\n        <div class=\"card\">\r\n          <div class=\"card-head\">\r\n            <h2>Active</h2>\r\n            <div class=\"spacer\"></div>\r\n            <span class=\"badge\" id=\"txCount\"></span>\r\n            <button class=\"btn primary sm\" id=\"txBegin\">+ Begin transaction</button>\r\n          </div>\r\n          <div class=\"tbl-wrap\" id=\"txTable\"></div>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- ========== INDEXES (Non-Relational NoSQL Engine) ========== -->\r\n      <section class=\"panel\" id=\"panel-indexes\">\r\n        <div class=\"panel-head\">\r\n          <h1>Secondary Indexes <span class=\"engine-tag nosql\" title=\"Non-Relational NoSQL Engine — document indexes\">Non-Relational NoSQL Engine</span></h1>\r\n          <span class=\"hint\">Per-collection field indexes</span>\r\n        </div>\r\n        <div class=\"card\">\r\n          <div class=\"card-head\">\r\n            <h2>Inspect / create</h2>\r\n            <div class=\"spacer\"></div>\r\n            <input type=\"text\" id=\"idxCol\" placeholder=\"collection\" style=\"max-width:200px\">\r\n            <button class=\"btn sm\" id=\"idxList\">List</button>\r\n          </div>\r\n          <div class=\"card-pad\" style=\"display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap\">\r\n            <div><label class=\"fld\">Field</label><input type=\"text\" id=\"idxField\" placeholder=\"email\" style=\"width:200px\"></div>\r\n            <button class=\"btn primary sm\" id=\"idxCreate\">Create index</button>\r\n            <span class=\"badge\" id=\"idxStatus\"></span>\r\n          </div>\r\n          <div class=\"card-pad\" style=\"padding-top:0\"><div id=\"idxOut\"></div></div>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- ========== BACKUP (shared) ========== -->\r\n      <section class=\"panel\" id=\"panel-backup\">\r\n        <div class=\"panel-head\">\r\n          <h1>Backup &amp; Restore <span class=\"engine-tag shared\" title=\"Shared capability — both engines\">Both Engines</span></h1>\r\n          <span class=\"hint\">Snapshot the data directory or restore from a backup file</span>\r\n        </div>\r\n        <div class=\"grid cols-2\">\r\n          <div class=\"card\">\r\n            <div class=\"card-head\"><h2>Status</h2><div class=\"spacer\"></div><button class=\"btn sm\" id=\"bkRefresh\">Refresh</button></div>\r\n            <div class=\"card-pad\" id=\"bkInfo\"><div class=\"loading-row\"><span class=\"spinner\"></span>Loading backup status…</div></div>\r\n          </div>\r\n          <div class=\"card\">\r\n            <div class=\"card-head\"><h2>Actions</h2></div>\r\n            <div class=\"card-pad\">\r\n              <button class=\"btn primary\" id=\"bkCreate\">Create backup</button>\r\n              <div style=\"margin-top:14px\">\r\n                <label class=\"fld\">Restore from file path</label>\r\n                <input type=\"text\" id=\"bkFile\" placeholder=\"backups/backup-…\">\r\n                <button class=\"btn sm\" id=\"bkRestore\" style=\"margin-top:8px\">Restore</button>\r\n              </div>\r\n              <span class=\"badge\" id=\"bkStatus\"></span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- ========== CDC & EVENTS (shared) ========== -->\r\n      <section class=\"panel\" id=\"panel-cdc\">\r\n        <div class=\"panel-head\">\r\n          <h1>Change Data Capture <span class=\"engine-tag shared\" title=\"Shared capability — both engines\">Both Engines</span></h1>\r\n          <span class=\"hint\">Event log, connectors, and enable/disable</span>\r\n        </div>\r\n        <div class=\"grid cols-2\">\r\n          <div class=\"card\">\r\n            <div class=\"card-head\">\r\n              <h2>Status</h2><div class=\"spacer\"></div>\r\n              <span class=\"badge\" id=\"cdcState\"></span>\r\n              <button class=\"btn sm\" id=\"cdcToggle\">Toggle</button>\r\n            </div>\r\n            <div class=\"card-pad\" id=\"cdcStatus\"><div class=\"loading-row\"><span class=\"spinner\"></span>Loading CDC status…</div></div>\r\n          </div>\r\n          <div class=\"card\">\r\n            <div class=\"card-head\"><h2>Connectors</h2><div class=\"spacer\"></div><button class=\"btn sm\" id=\"cdcRefresh\">Refresh</button></div>\r\n            <div class=\"card-pad\">\r\n              <div style=\"display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap\">\r\n                <div><label class=\"fld\">Name</label><input type=\"text\" id=\"cdcName\" placeholder=\"sink-1\" style=\"width:130px\"></div>\r\n                <div><label class=\"fld\">Type</label>\r\n                  <select id=\"cdcType\" style=\"width:110px\"><option value=\"file\">file</option><option value=\"kafka\">kafka</option></select>\r\n                </div>\r\n                <div><label class=\"fld\">Param (dir / servers)</label><input type=\"text\" id=\"cdcParam\" placeholder=\"target/cdc-out\" style=\"width:200px\"></div>\r\n                <button class=\"btn sm\" id=\"cdcAdd\">Connect</button>\r\n              </div>\r\n              <div style=\"margin-top:12px\"><div id=\"cdcConnectors\"><div class=\"empty\">No connectors configured.</div></div></div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"card\" style=\"margin-top:16px\">\r\n          <div class=\"card-head\"><h2>Event log</h2><div class=\"spacer\"></div><button class=\"btn sm\" id=\"cdcEvents\">Load events</button></div>\r\n          <div class=\"tbl-wrap\" id=\"cdcTable\"></div>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- ========== AUDIT (shared) ========== -->\r\n      <section class=\"panel\" id=\"panel-audit\">\r\n        <div class=\"panel-head\">\r\n          <h1>Audit Trail <span class=\"engine-tag shared\" title=\"Shared capability — both engines\">Both Engines</span></h1>\r\n          <span class=\"hint\">Recent mutating operations (bounded in-memory log)</span>\r\n        </div>\r\n        <div class=\"card\">\r\n          <div class=\"card-head\"><h2>Events</h2><div class=\"spacer\"></div><button class=\"btn sm\" id=\"audRefresh\">Refresh</button></div>\r\n          <div class=\"tbl-wrap\" id=\"audTable\"></div>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- ========== SERVER (CLI / legacy) ========== -->\r\n      <section class=\"panel\" id=\"panel-server\">\r\n        <div class=\"panel-head\">\r\n          <h1>Server <span class=\"engine-tag shared\" title=\"Shared capability — both engines\">Both Engines</span></h1>\r\n          <span class=\"hint\">Health details, JVM metrics, and connection info</span>\r\n        </div>\r\n        <div class=\"grid cols-2\">\r\n          <div class=\"card\">\r\n            <div class=\"card-head\"><h2>Health</h2><div class=\"spacer\"></div><button class=\"btn sm\" id=\"srvRefresh\">Refresh</button></div>\r\n            <div class=\"card-pad\"><pre class=\"code json\" id=\"srvHealth\"></pre></div>\r\n          </div>\r\n          <div class=\"card\">\r\n            <div class=\"card-head\"><h2>JVM metrics</h2></div>\r\n            <div class=\"card-pad\"><pre class=\"code json\" id=\"srvMetrics\"></pre></div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n\r\n    </main>\r\n  </div>\r\n\r\n  <div id=\"toasts\"></div>\r\n  <script src=\"/js/console.js\"></script>\r\n</body>\r\n</html>\r\n"}
