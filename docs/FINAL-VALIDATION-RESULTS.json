      "id": "BUG-01",
      "component": "WriteAheadLog",
      "description": "Windows file-locking prevented temporary test directory cleanup.",
      "resolution": "Explicitly closed logFileOutputStream in close() and truncate()."
    },
    {
      "id": "BUG-02",
      "component": "LSMTreeEngine",
      "description": "Bloom filter not populated on cold start from SSTables, causing null reads.",
      "resolution": "Iterated loaded SSTable keys into BloomFilter during engine load."
    },
    {
      "id": "BUG-03",
      "component": "BTreeEngine",
      "description": "BTreeEngine.close() marked closed=true before flush(), throwing IllegalStateException.",
      "resolution": "Flushed dirty keys before setting closed=true."
    },
    {
      "id": "BUG-04",
      "component": "InMemoryEngine",
      "description": "Redundant CRC32 calculation in RAM-only engine reduced write throughput.",
      "resolution": "Removed CRC32 calculation from InMemoryEngine."
    },
    {
      "id": "BUG-05",
      "component": "AdminConsole",
      "description": "Port collision resulted in unhandled bind exceptions; missing CSRF, brute-force lockout, and configurable URL scheme/path.",
